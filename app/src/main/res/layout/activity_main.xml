<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05"
            android:text="Calculator"
            android:textColor="#E1000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/body_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_body_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_title">

        <EditText
            android:id="@+id/input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@android:color/transparent"
            android:cursorVisible="true"
            android:focusable="false"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:inputType="none"
            android:textColor="#000000"
            android:textSize="54sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="Autofill,LabelFor"
            tools:layout_editor_absoluteX="20dp" />

        <TextView
            android:id="@+id/digit_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="25dp"
            android:layout_marginTop="5dp"
            android:alpha="0.6"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:textColor="#282828"
            android:textSize="32sp"
            app:layout_constraintTop_toBottomOf="@id/input_box"
            tools:layout_editor_absoluteX="25dp" />

        <LinearLayout
            android:id="@+id/buttons_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/digit_total"
            app:layout_constraintVertical_bias="0.8">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="C"
                    android:textColor="#C53434"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/delete_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brackets"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="( )"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/operators_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/percentage"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="%"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/operators_buttn"/>

                <ImageButton
                    android:id="@+id/backspace"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_background"
                    android:backgroundTint="@color/operators_buttn"
                    android:contentDescription="backspace"
                    android:scaleType="center"
                    android:src="@drawable/backspace"
                    android:tint="@color/black"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key7"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="7"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key8"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="8"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key9"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="9"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/devide"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="÷"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/operators_buttn"/>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key4"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="4"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key5"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="5"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key6"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="6"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/multiply"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="×"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/operators_buttn"/>
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key1"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="1"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key2"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="2"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key3"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="3"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtract"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="−"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/operators_buttn"/>
            </LinearLayout>

            <!-- Row 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dot"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="."
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key0"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    app:backgroundTint="@color/number_buttn"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/equal"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="="
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4A9B7F"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    app:backgroundTint="@color/operators_buttn"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>