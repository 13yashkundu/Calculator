<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DEDEDE"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inputs_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="10dp"
            android:background="@android:color/transparent"
            android:cursorVisible="true"
            android:focusable="false"
            android:gravity="end"
            android:inputType="none"
            android:paddingStart="8dp"
            android:textAlignment="viewEnd"
            android:textColor="#000000"
            android:textSize="48sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            android:id="@+id/digit_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:textColor="#282828"
            android:textSize="38sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_box"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/backspace"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/backspace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputs_parent"/>

    <LinearLayout
        android:id="@+id/buttons_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/backspace">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/delete"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="C"
                android:textColor="#C53434"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/brackets"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="( )"
                android:textColor="#649FC3"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/percentage"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="%"
                android:textColor="#649FC3"
                android:textSize="24sp"/>

            <Button
                android:id="@+id/devide"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="÷"
                android:textColor="#649FC3"
                android:textSize="24sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key7"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="7"
                android:textColor="#000000"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key8"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="8"
                android:textColor="@color/black"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key9"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="9"
                android:textColor="@color/black"
                android:textSize="24sp"/>

            <Button
                android:id="@+id/multiply"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="×"
                android:textColor="#649FC3"
                android:textSize="24sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="4"
                android:textColor="#000000"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="5"
                android:textColor="@color/black"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="6"
                android:textColor="@color/black"
                android:textSize="24sp"/>

            <Button
                android:id="@+id/subtract"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="−"
                android:textColor="#649FC3"
                android:textSize="24sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="1"
                android:textColor="#000000"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="2"
                android:textColor="@color/black"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="3"
                android:textColor="@color/black"
                android:textSize="24sp"/>

            <Button
                android:id="@+id/addition"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="+"
                android:textColor="#649FC3"
                android:textSize="24sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="0"
                android:textColor="#000000"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="5"
                android:textColor="@color/black"
                android:textSize="23sp"/>

            <Button
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="6"
                android:textColor="@color/black"
                android:textSize="24sp"/>

            <Button
                android:id="@+id/brackets"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="( )"
                android:textColor="#649FC3"
                android:textSize="24sp"/>
        </LinearLayout>

    </LinearLayout>



        


</androidx.constraintlayout.widget.ConstraintLayout>