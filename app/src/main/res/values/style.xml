<resources>

    <style name="CalcBaseButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CalcNumberButton" parent="CalcBaseButton">
        <item name="backgroundTint">#1C1F26</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CalcOperatorButton" parent="CalcBaseButton">
        <item name="backgroundTint">#4B8BFF</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CalcSpecialButton" parent="CalcBaseButton">
        <item name="backgroundTint">#FF5C5C</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CalcEqualButton" parent="CalcBaseButton">
        <item name="backgroundTint">#00C896</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>